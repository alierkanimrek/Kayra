#!/bin/bash
#
# run - runit service for the Kayra group management service
#       (kayra-group-services).
#
# The service owns the job socket that the user scripts use to list, add and
# remove the groups of a user and to add the required system groups. It runs as
# root because usermod, gpasswd and the /etc/group updates need root.
#
# Runtime layout:
#   /run/kayra-group-services/groups.sock    0660 root:kayra-admin  job socket
#   /run/kayra-group-services/groups.lock    0640 root:kayra-admin  flock lock
#   /run/kayra-group-services/events.ndjson  0644 root:root   event stream
#
# The job socket is served with socat-link.sh: every connection is handled by
# handler.sh under an exclusive flock, so jobs are serialized and the kernel
# releases the lock when the handler exits.
#
# The event stream is written by the handler. The handler also writes every
# event to the requesting client, so the sending user script can show its own
# notifications. events.ndjson stays in place for auditing and for a future
# central monitor.
#
# Used commands: install, chown, chmod, logger, socat (via socat-link.sh)
#

exec 2>&1

export LC_ALL=C.UTF-8
PATH=/usr/bin:/usr/sbin:/bin:/sbin
umask 027

RUN_DIR="/run/kayra-group-services"
LOCK_FILE="$RUN_DIR/groups.lock"
EVENTS_FILE="$RUN_DIR/events.ndjson"
HANDLER="/usr/local/libexec/kayra-group-services/handler.sh"

# Fixed service paths. Exporting them keeps the handler independent from the
# environment that socat would otherwise inherit.
export EVENTS_FILE

install -d -m 0755 -o root -g root "$RUN_DIR" || exit 1
chown root:root "$RUN_DIR" 2>/dev/null || true
chmod 0755 "$RUN_DIR" 2>/dev/null || true

# The admin group is hard coded. Create it when a service starts on an
# upgraded system where the first-boot helper has not run yet.
if ! getent group kayra-admin >/dev/null 2>&1; then
    groupadd -r kayra-admin 2>/dev/null ||
        getent group kayra-admin >/dev/null 2>&1 || exit 1
fi

[ -e "$LOCK_FILE" ] ||
    install -m 0640 -o root -g kayra-admin /dev/null "$LOCK_FILE" || exit 1
[ -e "$EVENTS_FILE" ] ||
    install -m 0644 -o root -g root /dev/null "$EVENTS_FILE" || exit 1

# Keep the permissions correct even when the files already existed.
chown root:kayra-admin "$LOCK_FILE" 2>/dev/null || true
chmod 0640 "$LOCK_FILE" 2>/dev/null || true
chown root:root "$EVENTS_FILE" 2>/dev/null || true
chmod 0644 "$EVENTS_FILE" 2>/dev/null || true

if [ ! -x "$HANDLER" ]; then
    logger -t kayra-group-services -p user.err \
        "Handler not found: $HANDLER" 2>/dev/null || true
    exit 1
fi

logger -t kayra-group-services -p user.info \
    "Starting job socket: $RUN_DIR/groups.sock" 2>/dev/null || true

. /usr/local/lib/kayra/socat-link.sh

SL_SOCK_MODE=0660 SL_SOCK_GROUP=kayra-admin SL_LOCK_GRACE=5 \
    sl_serve "$RUN_DIR/groups.sock" "$HANDLER"
