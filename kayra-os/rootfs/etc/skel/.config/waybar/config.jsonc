// -*- mode: jsonc -*-
{
    "height": 30,
    "spacing": 4,
    "modules-left": [
	"custom/app-menu",
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "custom/media"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "tray",
	"custom/clipboard",
	"custom/network",
	"custom/wifi",
	"custom/connection-warning",
	"custom/notification",
	"battery",
	"custom/spacer",
        "group/power-drawer"
    ],
    "tray": {
        "spacing": 10
    },

    // Grup tanımı
"group/power-drawer": {
    "orientation": "horizontal",
    "drawer": {
        "transition-duration": 0,
        "transition-left-to-right": false
    },
    "modules": [
        "custom/power-trigger",
	"custom/user-info",
        "custom/lock",
        "custom/logout",
        "custom/reboot",
        "custom/shutdown"
    ]
},
    // Alt modül tanımları
"custom/power-trigger": {
    "format": "\ue5d4", // drag-vertical / tutamaç
    "tooltip": false
},

"custom/lock": {
    "format": "\ue897", // lock
    "tooltip": true,
    "tooltip-format": "Kilitle",
    "on-click": "loginctl lock-session"
},

"custom/logout": {
    "format": "\ue9ba", // logout
    "tooltip": true,
    "tooltip-format": "Oturumu Kapat",
    "on-click": "loginctl terminate-user $USER"
},

"custom/reboot": {
    "format": "\ue042", // reload / reboot
    "tooltip": true,
    "tooltip-format": "Yeniden Başlat",
    "on-click": "loginctl reboot"
},

"custom/shutdown": {
    "format": "\ue8ac", // power
    "tooltip": true,
    "tooltip-format": "Kapat",
    "on-click": "loginctl poweroff"
},

// SwayNotificationCenter Bildirim Modülü
"custom/notification": {
	"tooltip": false,
	"format": "{icon}",
	"format-icons": {
		"notification": "\ue7f7",
		"none": "",
		"dnd-notification": "\ue7f7",
		"dnd-none": "",
		"inhibited-notification": "\ue7f7",
		"inhibited-none": ""
	},
	"return-type": "json",
	"exec-if": "which swaync-client",
	"exec": "swaync-client -swb",
	"on-click": "swaync-client -t -sw",
	"on-click-right": "swaync-client -d -sw",
	"escape": true
},

"custom/connection-warning": {
	"exec": "$HOME/.local/bin/connection-check.sh",
	"return-type": "json",
	"restart-interval": 30,
	"tooltip": true,
	"escape": true,
	"on-click": "nm-connection-editor"
},

"custom/network": {
	"exec": "$HOME/.local/bin/net-monitor.sh --ethernet \"en*\" --other \"docker*,veth*,br-*,virbr*\"",
	"return-type": "json",
	"restart-interval": 30,
	"tooltip": true,
	"on-click": "nm-connection-editor"
},

"custom/wifi": {
	"exec": "$HOME/.local/bin/wifi-monitor.sh",
	"exec-if": "nmcli -t -f TYPE device status | grep -q '^wifi$'",
	"return-type": "json",
	"restart-interval": 0,
	"tooltip": true,
	"escape": true,
	"on-click": "$HOME/.local/bin/wifi-menu.sh",
	"on-click-right": "nm-connection-editor"
},

"custom/clipboard": {
	"format": "\ue14f",
	"on-click": "pkill fuzzel; cliphist list | fuzzel --dmenu --anchor=top-right --log-no-syslog | cliphist decode | wl-copy",
	"on-click-right": "cliphist wipe",
	"tooltip": true,
	"tooltip-format": "Sol tık: Pano Geçmişi\nSağ tık: Geçmişi Temizle"
},

"custom/app-menu": {
	"format": "\ue5c3",
	"tooltip": true,
	"tooltip-format": "Uygulama Menüsü",
	"on-click": "pkill fuzzel; fuzzel --anchor=top-left --log-no-syslog"
},

"custom/user-info": {
    "format": "{}",
    "exec": "$HOME/.local/bin/user-info.sh",
    "return-type": "json",
    "interval": 30,
    "tooltip": true,
    "on-click": "~/.local/bin/fuzzel-menu.sh user-menu.json --anchor=top-right",
    "escape": false
},
"battery": {
	"bat": "BAT1",
	"interval": 60,
	"states": {
		"warning": 30,
		"critical": 15
	},
	"events": {
		"on-discharging-warning": "notify-send -u normal 'Low Battery'",
		"on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
		"on-charging-100": "notify-send -u normal 'Battery Full!'",
		"on-discharging": "notify-send -u normal 'Power Switch' Discharging",
		"on-charging": "notify-send -u normal 'Power Switch' Charging'"
	},
	"format": "{icon}",
	"format-charging": "{icon}",
	"format-icons": {
		"default": ["\uf30d", "\uf30c", "\uf30b", "\uf30a", "\uf309", "\uf308", "\uf304"],
		"charging": ["\uf305","\uDBBF\uDF3E", "\uDBBF\uDF3D", "\uDBBF\uDF3B", "\uDBBF\uDF3A", "\uf304"]
	},
	"max-length": 25,
	"tooltip": true,
	"tooltip-format": "Kapasite: {capacity}% ({time})",
	"tooltip-format-charging": "Şarj Oluyor: {capacity}% (Dolmaya kalan: {time})"
},

"custom/spacer": {
	"format": " "
}

}

