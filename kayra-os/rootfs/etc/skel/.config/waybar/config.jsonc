// -*- mode: jsonc -*-
{
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "custom/media"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "tray",
        "custom/power"
    ],
    "tray": {
        "spacing": 10
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "nwgbar",
        "tooltip": false
    }
}
