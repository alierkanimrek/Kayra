// -*- mode: jsonc -*-
{
    "include": ["~/.config/waybar/app-pins.conf"],
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "custom/app-menu",
        "custom/xbps-updates-monitor",
        "custom/xbps-lock-monitor",        
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "group/app-pins",
        "custom/media"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "custom/memory-monitor",
        "custom/removable-monitor",
        "custom/connection-warning",
        "custom/notification",
        "tray",
        "wireplumber",
        "wireplumber#mic",
        "custom/clipboard",
        "custom/network",
        "custom/airplane",
        "custom/wifi",
        "custom/bluetooth",
        "battery",
        "clock",
        "custom/spacer",
        "group/power-drawer"
    ],
    "tray": {
        "spacing": 10
    },

    "group/power-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 0,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power-trigger",
            "custom/user-info",
            "custom/system-info",
            "custom/power-button"
        ]
    },
    "custom/power-trigger": {
        "format": "",
        "tooltip": false
    },

    "custom/power-button": {
        "format": "", // power
        "tooltip": false,
        "on-click": "$HOME/.local/bin/power-menu.sh"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/connection-warning": {
        "exec": "$HOME/.local/bin/connection-check.sh",
        "return-type": "json",
        "restart-interval": 30,
        "tooltip": true,
        "escape": true,
        "on-click": "nm-connection-editor"
    },

    "custom/airplane": {
        "exec": "$HOME/.local/bin/airplane-monitor.sh",
        "return-type": "json",
        "restart-interval": 0,
        "tooltip": true,
        "escape": true,
        "on-click": "$HOME/.local/bin/airplane-toggle.sh"
    },

    "custom/network": {
        "exec": "$HOME/.local/bin/net-monitor.sh --ethernet \"en*\" --other \"docker*,veth*,br-*,virbr*\"",
        "return-type": "json",
        "restart-interval": 30,
        "tooltip": true,
        "on-click": "nm-connection-editor"
    },

    "custom/wifi": {
        "exec": "$HOME/.local/bin/wifi-monitor.sh",
        "exec-if": "nmcli -t -f TYPE device status | grep -q '^wifi$'",
        "return-type": "json",
        "restart-interval": 0,
        "tooltip": true,
        "escape": true,
        "on-click": "$HOME/.local/bin/wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },
    "custom/bluetooth": {
        "exec": "$HOME/.local/bin/bluetooth-monitor.sh",
        "exec-if": "command -v bluetoothctl >/dev/null 2>&1",
        "return-type": "json",
        "restart-interval": 0,
        "tooltip": true,
        "escape": true,
        "on-click": "$HOME/.local/bin/bluetooth-menu.sh"
    },
    "custom/removable-monitor": {
        "exec": "$HOME/.local/bin/removable-storage-monitor.sh",
        "return-type": "json",
        "restart-interval": 0,
        "tooltip": true,
        "escape": true,
        "on-click": "$HOME/.local/bin/removable-menu.sh",
        "on-click-right": "$HOME/.local/bin/removable-eject-menu.sh"
    },

    "custom/clipboard": {
        "format": "",
        "on-click": "pkill fuzzel; cliphist list | fuzzel --dmenu --anchor=top-right --log-no-syslog | cliphist decode | wl-copy",
        "on-click-right": "cliphist wipe",
        "tooltip": true,
        "tooltip-format": "{{CLIPBOARD_TOOLTIP}}"
    },

    "custom/app-menu": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "{{APP_MENU_TOOLTIP}}",
        "on-click": "pkill fuzzel; fuzzel --anchor=top-left --log-no-syslog",
        "on-click-right": "$HOME/.local/bin/kayra-xbps-manager.sh"
    },

    "custom/user-info": {
        "format": "\ue853",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/user-menu.sh",
        "escape": false
    },

    "custom/system-info": {
        "format": "\ue8b8",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/system-menu.sh",
        "escape": false
    },

    "custom/app-pin-trigger": {
        "format": "\uEF40",
        "tooltip": true,
        "tooltip-format": "{{APP_PINS_TOOLTIP}}",
        "on-click": "$HOME/.local/bin/waybar-app-pins.sh menu",
        "on-click-right": "$HOME/.local/bin/waybar-app-pins.sh command"
    },
    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "notify-send -u normal '{{BATTERY_EVENT_WARNING}}'",
            "on-discharging-critical": "notify-send -u critical '{{BATTERY_EVENT_CRITICAL}}'",
            "on-charging-100": "notify-send -u normal '{{BATTERY_EVENT_FULL}}'",
            "on-discharging": "notify-send -u normal '{{BATTERY_EVENT_DISCHARGING}}'",
            "on-charging": "notify-send -u normal '{{BATTERY_EVENT_CHARGING}}'"
        },
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-icons": {
            "default": ["", "", "", "", "", "", ""],
            "charging": ["","󿼾", "󿼽", "󿼻", "󿼺", ""]
        },
        "max-length": 25,
        "tooltip": true,
        "tooltip-format": "{{BATTERY_TOOLTIP}}",
        "tooltip-format-charging": "{{BATTERY_TOOLTIP_CHARGING}}"
    },

    "wireplumber": {
        "format": "{icon}",
        "format-muted": "\ue04f",
        "format-icons": ["\ue04d", "\ue04d", "\ue050"],
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pwvucontrol -t 1",
        "tooltip-format": "%{volume} - {node_name}"
    },


    "wireplumber#mic": {
        "node-type": "Audio/Source",
        "format": "{icon}",
        "format-muted": "\ue02b",
        "format-icons": ["\ue029", "\ue029", "\ue029"],
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pwvucontrol -t 2",
        "tooltip-format": "%{volume} - {node_name}"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y}",
        "tooltip-format": "{:%d %B %Y, %A}",
        "on-click": "",
        "actions": {
            "on-click": "",
            "on-click-right": "toggle"
        }
    },

    "custom/memory-monitor": {
        "exec": "$HOME/.local/bin/memory-monitor.sh",
        "return-type": "json",
        "hide-empty-text": true,
        "tooltip": true,
        "restart-interval": 0,
        "on-click": "gnome-system-monitor -r",
    },
    
    "custom/xbps-lock-monitor": {
        "exec": "$HOME/.local/bin/xbps-lock-monitor.sh",
        "return-type": "json",
        "hide-empty-text": true,
        "tooltip": true,
        "restart-interval": 0
    },

    "custom/xbps-updates-monitor": {
        "exec": "$HOME/.local/bin/kayra-xbps-updates-monitor.sh",
        "return-type": "json",
        "hide-empty-text": true,
        "tooltip": true,
        "on-click": "$HOME/.local/bin/kayra-xbps-updates-menu.sh",
        "restart-interval": 0
    },
    
    "custom/spacer": {
        "format": " ",
        "tooltip": false
    }

}
