#!/bin/bash
#
# kayra-deploy - copy the Kayra OS overlay to the running system.
#
# Developer helper: lives in utils/ and is never installed.
#
# Source of truth:
#   <repo>/kayra-os/rootfs
#
# The tool is split into a few small tasks. Every task always copies, there is
# no change detection, no backup and no dry-run; running it twice is harmless.
#
# Targets:
#   scripts    usr/local/lib/kayra/      -> /usr/local/lib/kayra/    (0644)
#              usr/local/bin/kayra-*    -> /usr/local/bin/          (0755)
#   lang       usr/local/share/kayra/lang/ -> /usr/local/share/kayra/lang/ (0644)
#   data       usr/local/share/kayra/data/ -> /usr/local/share/kayra/data/ (0644)
#   services   etc/sv/<name>/            -> /etc/sv/<name>/         (0755, run/finish)
#              usr/local/libexec/<name>/ -> /usr/local/libexec/<name>/
#              enable the service when it is not linked yet, then
#              "sv restart <name>" for every service found
#   core       etc/runit/core-services/  -> /etc/runit/core-services/ (0755)
#   session    usr/share/wayland-sessions/ -> /usr/share/wayland-sessions/
#              (0644) installs kayra.desktop
#   system     etc/default/kayra.conf    -> /etc/default/kayra.conf  (0644)
#   admin      create the kayra-admin group and add the deploy caller
#   migrate    seed the locale key of every user settings.conf, remove the
#              legacy LANG/LC_ALL lines from ~/.profile and prune obsolete
#              keys, keeping owner and mode
#   cleanup    remove the retired Kayra helpers, the kayra-check-groups line
#              and the old greetd session wrapper/desktop
#   config     etc/skel/.config/         -> $HOME/.config/          (0644, user owned)
#   all        scripts + lang + data + core + session + system + admin
#              + migrate + cleanup + services (config is NOT included)
#
# Before anything is installed every shell file is checked with "bash -n"; on a
# syntax error nothing is installed.
#
# Usage:
#   sudo utils/kayra-deploy scripts
#   sudo utils/kayra-deploy scripts data
#   sudo utils/kayra-deploy services
#   sudo utils/kayra-deploy session
#   sudo utils/kayra-deploy admin
#   sudo utils/kayra-deploy cleanup
#   sudo utils/kayra-deploy config
#   sudo utils/kayra-deploy all
#   sudo utils/kayra-deploy            # same as "all"
#
set -uo pipefail
export LC_ALL=C.UTF-8

SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd -P)
REPO=${KAYRA_REPO:-$(dirname -- "$SCRIPT_DIR")}
SRC=$REPO/kayra-os/rootfs

die() { printf 'kayra-deploy: %s\n' "$*" >&2; exit 1; }

[[ -d $SRC ]] || die "not a Kayra repo (missing kayra-os/rootfs): $REPO"
(( EUID == 0 )) || die "run as root (sudo)"

# Identity used for the user owned files of the config task.
DEPLOY_USER=${SUDO_USER:-$(id -un)}
DEPLOY_UID=${SUDO_UID:-$(id -u "$DEPLOY_USER")}
DEPLOY_GID=${SUDO_GID:-$(id -g "$DEPLOY_USER")}
DEPLOY_HOME=$(getent passwd "$DEPLOY_USER" | cut -d: -f6)
[[ -n $DEPLOY_HOME ]] || die "cannot resolve home directory for $DEPLOY_USER"

# sync_dir <src-rel> <dst> <mode>
sync_dir() {
  local rel=$1 dst=$2 mode=$3
  [[ -d $SRC/$rel ]] || return 0
  install -d -m 0755 -o root -g root "$dst" || die "cannot create: $dst"
  find "$SRC/$rel" -type f -exec install -m "$mode" -o root -g root {} "$dst/" \;
}

task_scripts() {
  sync_dir usr/local/lib/kayra /usr/local/lib/kayra 0644
  sync_dir usr/local/bin       /usr/local/bin       0755
}

task_lang() {
  sync_dir usr/local/share/kayra/lang /usr/local/share/kayra/lang 0644
}

task_data() {
  sync_dir usr/local/share/kayra/data /usr/local/share/kayra/data 0644
}

task_services() {
  local d n enabled i
  for d in "$SRC"/etc/sv/*/; do
    [[ -d $d ]] || continue
    n=${d%/}; n=${n##*/}
    sync_dir "etc/sv/$n" "/etc/sv/$n" 0755
    sync_dir "usr/local/libexec/$n" "/usr/local/libexec/$n" 0755
    # Enable the service when it is not linked yet, so the development
    # deployment also works on a fresh system. A new link needs a moment
    # before runsvdir creates supervise/ok; without the wait "sv restart"
    # fails with "file does not exist".
    enabled=0
    if [[ -d /var/service && ! -e /var/service/$n ]]; then
      if ln -s "/etc/sv/$n" "/var/service/$n"; then
        enabled=1
      else
        printf 'kayra-deploy: warning: %s not enabled\n' "$n" >&2
      fi
    fi
    if (( enabled )); then
      for ((i = 0; i < 50; i++)); do
        [[ -e /var/service/$n/supervise/ok ]] && break
        sleep 0.1
      done
      sv up "/var/service/$n" >/dev/null 2>&1 ||
        printf 'kayra-deploy: warning: %s not started\n' "$n" >&2
    else
      sv restart "/var/service/$n" >/dev/null 2>&1 ||
        printf 'kayra-deploy: warning: %s not restarted\n' "$n" >&2
    fi
  done
}

task_core() {
  sync_dir etc/runit/core-services /etc/runit/core-services 0755
}

# session installs the standard Wayland session entry. Login managers other
# than greetd (GDM, SDDM, LightDM) scan this standard path.
task_session() {
  local src=$SRC/usr/share/wayland-sessions/kayra.desktop
  [[ -f $src ]] || die "missing session file: $src"
  install -d -m 0755 -o root -g root /usr/share/wayland-sessions ||
    die "cannot create: /usr/share/wayland-sessions"
  install -m 0644 -o root -g root "$src" /usr/share/wayland-sessions/kayra.desktop ||
    die "cannot install: /usr/share/wayland-sessions/kayra.desktop"
}

# system installs the system wide defaults file (required_groups,
# protected_services).
task_system() {
  local src=$SRC/etc/default/kayra.conf
  [[ -f $src ]] || return 0
  install -d -m 0755 -o root -g root /etc/default || die "cannot create: /etc/default"
  install -m 0644 -o root -g root "$src" /etc/default/kayra.conf \
    || die "cannot install: /etc/default/kayra.conf"
}

# admin creates the fixed Kayra administrator group and adds the deploy
# caller. It is safe to run repeatedly. The first-boot helper performs the same
# setup for the installation user on a fresh system.
task_admin() {
  local user=${DEPLOY_USER:-root}

  getent group kayra-admin >/dev/null ||
    groupadd -r kayra-admin || die "cannot create group: kayra-admin"

  if [[ $user != root ]]; then
    usermod -aG kayra-admin "$user" ||
      die "cannot add $user to kayra-admin"
  fi

  printf 'kayra-deploy: kayra-admin ready (members: %s)\n' \
    "$(getent group kayra-admin | cut -d: -f4)"
}

# conf_file_value <file> <key> -> value without surrounding quotes
conf_file_value() {
  local file=$1 key=$2
  grep -m1 "^${key}=" "$file" 2>/dev/null | cut -d= -f2- | sed 's/^"//;s/"$//'
}

# set_conf_file_value <file> <key> <value>
set_conf_file_value() {
  local file=$1 key=$2 value=$3 esc
  esc=$(printf '%s' "$value" | sed -e 's/[\/&\\]/\\&/g')
  if grep -q "^${key}=" "$file" 2>/dev/null; then
    sed -i "s/^${key}=.*/${key}=\"${esc}\"/" "$file"
  else
    printf '%s="%s"\n' "$key" "$value" >>"$file"
  fi
}

# migrate seeds the session locale, removes the legacy LANG/LC_ALL lines from
# the user profile and prunes keys that moved out of the settings files. sed -i
# replaces files, so the original owner and mode are restored afterwards.
task_migrate() {
  local home profile conf owner mode old_lang lang locale sys_lang changed
  local registry=$SRC/usr/local/share/kayra/lang/languages.tsv
  local -A REG_LOCALE=()

  if [[ -r $registry ]]; then
    while IFS=$'\t' read -r code loc rest; do
      case $code in ''|'#'*) continue ;; esac
      REG_LOCALE[$code]=$loc
    done <"$registry"
  fi

  sys_lang=$(awk -F= '/^LANG=/{print $2; exit}' /etc/locale.conf 2>/dev/null)
  sys_lang=$(printf '%s' "$sys_lang" | sed 's/^"//;s/"$//')
  case "$sys_lang" in
    ''|*[!A-Za-z0-9._@-]*) sys_lang=C.UTF-8 ;;
  esac

  for home in /home/* /root; do
    [[ -d $home ]] || continue
    profile=$home/.profile
    conf=$home/.config/kayra/settings.conf
    old_lang=""

    if [[ -f $profile ]]; then
      old_lang=$(grep -m1 '^export LANG=' "$profile" 2>/dev/null |
        cut -d= -f2- | tr -d '"' | tr -d '[:space:]')
      if grep -qE '^export (LANG|LC_ALL)=' "$profile" 2>/dev/null; then
        owner=$(stat -c '%u:%g' "$profile")
        mode=$(stat -c '%a' "$profile")
        sed -i -E '/^export (LANG|LC_ALL)=/d' "$profile"
        chown "$owner" "$profile"
        chmod "$mode" "$profile"
        printf 'kayra-deploy: removed legacy locale lines from %s\n' "$profile"
      fi
    fi

    [[ -f $conf ]] || continue
    owner=$(stat -c '%u:%g' "$conf")
    mode=$(stat -c '%a' "$conf")
    changed=0

    if grep -qE '^(required_groups|auto_group_management)=' "$conf"; then
      sed -i -E '/^(required_groups|auto_group_management)=/d' "$conf"
      changed=1
      printf 'kayra-deploy: removed obsolete group settings from %s\n' "$conf"
    fi

    lang=$(conf_file_value "$conf" lang)
    locale=$(conf_file_value "$conf" locale)

    if [[ -z $locale ]]; then
      if [[ -n $lang && -n ${REG_LOCALE[$lang]:-} ]]; then
        locale=${REG_LOCALE[$lang]}
      elif [[ -n $old_lang ]]; then
        locale=$old_lang
      else
        locale=$sys_lang
      fi
      case "$locale" in
        ''|*[!A-Za-z0-9._@-]*) locale=$sys_lang ;;
      esac
      if [[ -n $locale ]]; then
        set_conf_file_value "$conf" locale "$locale"
        changed=1
        printf 'kayra-deploy: set session locale to %s in %s\n' "$locale" "$conf"
      fi
    fi

    if (( changed )); then
      chown "$owner" "$conf"
      chmod "$mode" "$conf"
    fi
  done
}

# cleanup removes the retired helpers from older deployments and prunes the
# obsolete sway exec line. These files are no longer shipped by the repository.
task_cleanup() {
  local f owner mode
  for f in \
    /usr/local/bin/kayra-check-groups.sh \
    /usr/local/bin/kayra-fix-groups.sh \
    /usr/local/bin/kayra-sv-status-helper.sh \
    /usr/local/bin/kayra-sv-toggle-helper.sh; do
    [[ -e $f ]] || continue
    rm -f "$f" && printf 'kayra-deploy: removed %s\n' "$f"
  done

  # The greetd specific session wrapper and desktop are replaced by the
  # login-manager independent kayra.desktop. Remove them only when the new
  # session file is present, so the system is never left without a session.
  if [[ -f /usr/share/wayland-sessions/kayra.desktop && -x /usr/local/bin/kayra-session ]]; then
    for f in \
      /etc/greetd/wayland-sessions/sway.wrapper \
      /etc/greetd/wayland-sessions/sway.desktop; do
      [[ -e $f ]] || continue
      rm -f "$f" && printf 'kayra-deploy: removed %s\n' "$f"
    done
  else
    printf 'kayra-deploy: warning: new session files missing; kept greetd session files\n' >&2
  fi

  for f in /home/*/.config/sway/config /root/.config/sway/config; do
    [[ -f $f ]] || continue
    grep -qF 'kayra-check-groups.sh' "$f" || continue
    owner=$(stat -c '%u:%g' "$f")
    mode=$(stat -c '%a' "$f")
    sed -i '/kayra-check-groups\.sh/d' "$f"
    chown "$owner" "$f"
    chmod "$mode" "$f"
    printf 'kayra-deploy: removed kayra-check-groups from %s\n' "$f"
  done
}

# config copies the skel configuration into the user's home. Files the user
# owns or edits are kept: settings.conf, app-pins.list, autostart.list and the
# first-login flag are skipped.
task_config() {
  local src=$SRC/etc/skel/.config f rel dst
  [[ -d $src ]] || return 0
  while IFS= read -r -d '' f; do
    rel=${f#"$src/"}
    case $rel in
      kayra/settings.conf|kayra/app-pins.list|kayra/autostart.list|kayra/.firstlogin|waybar/config) continue ;;
    esac
    dst=$DEPLOY_HOME/.config/$rel
    install -d -m 0755 "$(dirname -- "$dst")" || die "cannot create: $(dirname -- "$dst")"
    install -m 0644 -o "$DEPLOY_UID" -g "$DEPLOY_GID" "$f" "$dst" \
      || die "cannot install: $dst"
  done < <(find "$src" -type f -print0 2>/dev/null)
}

task_all() {
  task_scripts
  task_lang
  task_data
  task_core
  task_session
  task_system
  task_admin
  task_migrate
  task_cleanup
  task_services
}

# Refuse to install anything when a shell file has a syntax error.
syntax_check() {
  local f rc=0
  while IFS= read -r -d '' f; do
    head -n1 "$f" | grep -qE '^#!.*(bash|/sh|env[[:space:]]+(bash|sh))' || continue
    if ! bash -n "$f"; then
      printf 'kayra-deploy: syntax error: %s\n' "$f" >&2
      rc=1
    fi
  done < <(find "$SRC/usr/local/lib/kayra" "$SRC/usr/local/bin" \
                 "$SRC/etc/sv" "$SRC/usr/local/libexec" \
                 -type f -print0 2>/dev/null)
  return "$rc"
}

syntax_check || die "syntax error(s) found; nothing installed"

(($#)) || set -- all
for task in "$@"; do
  case $task in
    scripts|lang|data|services|core|session|system|admin|migrate|cleanup|config|all) "task_$task" ;;
    *) die "unknown task: $task" ;;
  esac
done
